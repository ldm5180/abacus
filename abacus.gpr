with "config/abacus_config.gpr";
with "sml";

--  Abacus: fixed-point numerics proved in SPARK.  A pure library (zero
--  IO, no floating-point type): every unit carries SPARK_Mode and may
--  depend only on other Abacus units and the sml state-machine library.
--  Consumers build it through their Alire profile; the test crate
--  selects -O3/-O0 with the MODE external (the sml-ada convention).
--  proof/proof.gpr sources src/ directly and withs only sml, keeping
--  foreign code out of the proof tree.
project Abacus is

   for Library_Name use "Abacus";
   for Library_Version use
     Project'Library_Name & ".so." & Abacus_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Abacus_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("ABACUS_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Abacus_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Abacus;
