--  SPARK proof target for the spike.  Withs nothing: it sources the
--  spike's units directly, and proof/src holds the instances gnatprove
--  analyses the generics through, one per Frac measured.
project Proof is

   for Source_Dirs use ("src", "../src");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;

end Proof;
