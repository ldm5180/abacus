with "sml";

--  SPARK proof target.  Not built by `alr build`; analysed with
--  `alr exec -- gnatprove -P proof/proof.gpr`.
--
--  Sources the library directly (rather than withing abacus.gpr) because
--  the Alire-generated config gpr withs every dependency's project, which
--  would drag foreign code into the proof tree.  This tree is exactly the
--  proof harness + src + sml.  gnatprove analyses a generic only through
--  a concrete instance, so the harness withs every unit and instantiates
--  each generic at the sizes the library is used at.
project Proof is

   for Source_Dirs use ("src", "../src");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;

end Proof;
